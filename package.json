{
  "name": "tsuki",
  "private": true,
  "version": "0.1.0",
  "description": "A Discord music bot that runs on the audio node you bring, with a web dashboard that mirrors every command.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:bot": "pnpm --filter @tsuki/bot dev",
    "dev:web": "pnpm --filter @tsuki/web dev",
    "db:generate": "pnpm --filter @tsuki/db generate",
    "db:push": "pnpm --filter @tsuki/db push",
    "db:migrate": "pnpm --filter @tsuki/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines"
    ]
  }
}
