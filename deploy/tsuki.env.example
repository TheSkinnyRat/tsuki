# Production environment for deploy/compose.yml. Copy to deploy/tsuki.env.
# Every value marked REQUIRED must be set; the rest have working defaults.

# REQUIRED — the production Discord application (not the development one).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# REQUIRED — the password must match deploy/pg_password.txt.
DATABASE_URL=postgresql://tsuki:<password>@postgres:5432/tsuki

# REQUIRED — openssl rand -base64 32 / openssl rand -hex 32 / openssl rand -base64 32
ENCRYPTION_KEY=
BOT_API_TOKEN=
AUTH_SECRET=

# REQUIRED — the public dashboard address; register
# <AUTH_URL>/api/auth/callback/discord as the OAuth redirect.
AUTH_URL=https://tsukibot.app
AUTH_TRUST_HOST=true

# The public instance offers no node of its own: every guild brings one.
DEFAULT_NODE_HOST=
ALLOW_PRIVATE_NODE_HOSTS=false

BOT_API_PORT=3856
LOG_LEVEL=info
