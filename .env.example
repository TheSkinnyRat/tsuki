# ---------------------------------------------------------------- Discord
# Bot token and application id from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ---------------------------------------------------------------- database
# SQLite by default. Moving to PostgreSQL means changing `provider` in
# packages/db/prisma/schema.prisma and regenerating the migrations.
DATABASE_URL="file:../../../data/tsuki.db"

# ---------------------------------------------------------------- secrets
# Encrypts the Lavalink passwords guilds hand us. Generate with:
#   openssl rand -base64 32
# Rotating this makes every stored node password unreadable.
ENCRYPTION_KEY=

# Shared secret between the bot's internal API and the web dashboard.
#   openssl rand -hex 32
BOT_API_TOKEN=
BOT_API_PORT=3856
BOT_API_HOST=127.0.0.1

# ---------------------------------------------------------------- nodes
# Tsuki connects to the Lavalink node each guild supplies. A self-hosted
# instance can offer one of its own as the fallback for guilds that have not
# configured any; the public instance leaves these empty on purpose.
DEFAULT_NODE_HOST=
DEFAULT_NODE_PORT=2333
DEFAULT_NODE_PASSWORD=
DEFAULT_NODE_SECURE=false

# Guild-supplied hosts are refused when they resolve to a private address, so
# the bot cannot be pointed at someone else's internal network. Self-hosters
# whose node lives on the LAN set this to true.
ALLOW_PRIVATE_NODE_HOSTS=false

# ---------------------------------------------------------------- misc
NODE_ENV=development
LOG_LEVEL=info
